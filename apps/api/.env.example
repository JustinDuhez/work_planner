# Copy this file to apps/api/.env and adjust the values.
# NODE_ENV is deliberately absent: it defaults to development, Jest sets "test",
# and production sets "production" from the command line or the host.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://work_planner:work_planner@localhost:5432/work_planner
# Integration tests wipe this database: its name must end with _test.
TEST_DATABASE_URL=postgres://work_planner:work_planner@localhost:5432/work_planner_test
APP_TIMEZONE=Europe/Paris
LOG_LEVEL=info
